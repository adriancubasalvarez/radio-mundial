# Compilación de PlatformIO
.pio/
.vscode/

# Python
__pycache__/

# Descargas de las herramientas (Natural Earth, radio-browser, fuentes):
# se regeneran solas al ejecutar los scripts de tools/
tools/cache/

# Ajustes del simulador (volumen, favoritos...): son de cada usuario
ajustes.json

# «Tarjeta SD» del simulador (se genera con build_stations.py --destino sd)
sd/

# Red WiFi para las pruebas en la placa (contiene la contraseña)
data/wifi.txt

# Copias de la flash de las placas (pueden contener datos personales, p. ej. WiFi)
copias_placa/

# Previsualizaciones de los mapas y el logo (se regeneran con los scripts)
tools/preview/
